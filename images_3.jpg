<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Затишний номер для вашого відпочинку</title>
    <style>
        .hotel-banner {
            position: relative;
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #ffffff;
            box-sizing: border-box;
            overflow: hidden;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        .hotel-banner img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* Верхній блок: заголовок та логотип */
        .banner-header {
            position: absolute;
            top: 5%;
            left: 5%;
            right: 5%;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            pointer-events: none;
        }

        .banner-title-box {
            max-width: 65%;
        }

        .banner-title {
            font-size: clamp(18px, 3.5vw, 42px);
            font-weight: 800;
            text-transform: uppercase;
            margin: 0 0 5px 0;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
            letter-spacing: 1px;
        }

        .banner-subtitle {
            font-size: clamp(14px, 2.5vw, 32px);
            font-style: italic;
            margin: 0;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
        }

        .banner-logo {
            text-align: center;
            background: rgba(0, 0, 0, 0.4);
            padding: 8px 12px;
            border-radius: 6px;
            backdrop-filter: blur(2px);
        }

        .banner-logo-icon {
            font-size: clamp(16px, 2.5vw, 28px);
            font-weight: bold;
            letter-spacing: 2px;
        }

        .banner-logo-text {
            font-size: clamp(8px, 1.2vw, 12px);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 2px;
        }

        /* Нижній лівий блок: зручності */
        .banner-features {
            position: absolute;
            bottom: 8%;
            left: 5%;
            display: flex;
            flex-direction: column;
            gap: clamp(6px, 1.2vw, 14px);
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(0, 0, 0, 0.5);
            padding: 6px 12px;
            border-radius: 4px;
            backdrop-filter: blur(2px);
            font-size: clamp(11px, 1.8vw, 18px);
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .feature-item svg {
            width: clamp(16px, 2.2vw, 24px);
            height: clamp(16px, 2.2vw, 24px);
            fill: #ffffff;
        }

        /* Нижній правий блок: бронювання та телефон */
        .banner-booking {
            position: absolute;
            bottom: 8%;
            right: 5%;
            text-align: right;
        }

        .booking-cta {
            font-size: clamp(12px, 2.2vw, 26px);
            font-style: italic;
            margin-bottom: 8px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
            position: relative;
        }

        .phone-box {
            border: 2px solid #ffffff;
            padding: clamp(6px, 1.2vw, 12px) clamp(12px, 2.5vw, 24px);
            border-radius: 8px;
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(2px);
            display: inline-block;
        }

        .phone-number {
            font-size: clamp(14px, 3vw, 32px);
            font-weight: bold;
            text-decoration: none;
            color: #ffffff;
            letter-spacing: 1px;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.6);
        }
    </style>
</head>
<body>

    <div class="hotel-banner">
        <!-- Основне зображення -->
        <img src="watermarked_img_7899536180862673835.jpg" alt="Затишний номер для вашого відпочинку">

        <!-- Верхній блок (Заголовок + Логотип) -->
        <div class="banner-header">
            <div class="banner-title-box">
                <h1 class="banner-title">ЗАТИШНИЙ НОМЕР</h1>
                <p class="banner-subtitle">для вашого відпочинку</p>
            </div>
            <div class="banner-logo">
                <div class="banner-logo-icon">🏠 ГД</div>
                <div class="banner-logo-text">ГОСТИННИЙ ДВІР<br><span style="font-size: 8px;">РЕСТОРАН • ГОТЕЛЬ</span></div>
            </div>
        </div>

        <!-- Нижній лівий блок (Зручності) -->
        <div class="banner-features">
            <div class="feature-item">
                <svg viewBox="0 0 24 24"><path d="M20 9.5V7c0-1.1-.9-2-2-2H6c-1.1 0-2 .9-2 2v2.5c-1.1 0-2 .9-2 2v4.5h2v2c0 .55.45 1 1 1s1-.45 1-1v-2h12v2c0 .55.45 1 1 1s1-.45 1-1v-2h2V11.5c0-1.1-.9-2-2-2zM6 7h12v2.5H6V7zm14 9H4v-3.5c0-.83.67-1.5 1.5-1.5h13c.83 0 1.5.67 1.5 1.5V16z"/></svg>
                КОМФОРТНІ ЛІЖКА
            </div>
            <div class="feature-item">
                <svg viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61l1.42-1.42C4.55 15.03 4 13.58 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8c0 1.58-.55 3.03-1.46 4.19l1.42 1.42C20.26 16.07 21 14.12 21 12c0-4.97-4.03-9-9-9zm0 4c-2.76 0-5 2.24-5 5 0 1.18.42 2.26 1.11 3.11l1.42-1.42C9.28 13.3 9 12.68 9 12c0-1.66 1.34-3 3-3s3 1.34 3 3c0 .68-.28 1.3-.53 1.69l1.42 1.42C15.58 14.26 16 13.18 16 12c0-2.76-2.24-5-5-5zm0 4c-.55 0-1 .45-1 1 0 .28.11.53.29.71.18.18.43.29.71.29s.53-.11.71-.29c.18-.18.29-.43.29-.71 0-.55-.45-1-1-1z"/></svg>
                WI-FI
            </div>
            <div class="feature-item">
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                ПАРКОВКА
            </div>
        </div>

        <!-- Нижній правий блок (Бронювання) -->
        <div class="banner-booking">
            <div class="booking-cta">Бронюйте вже зараз!</div>
            <div class="phone-box">
                <a href="tel:0975787555" class="phone-number">0 (97) 578 75 55</a>
            </div>
        </div>
    </div>

</body>
</html>
